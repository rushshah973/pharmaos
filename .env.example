# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. Supabase: Project Settings -> Database -> Connection string
# -> "Transaction pooler" (port 6543). Local Postgres also works, e.g.
# postgres://postgres:postgres@localhost:5432/pharmaos
DATABASE_URL=

# Gemini API key from Google AI Studio (aistudio.google.com/apikey). Server-side only.
# Leave empty to run with the deterministic fallback.
GEMINI_API_KEY=
# Model for the orchestrator. Pin a specific model name on demo day if needed.
GEMINI_MODEL=gemini-flash-latest

# Optional: fix "today" for reproducible demos (YYYY-MM-DD). Empty = latest sale_date in the data.
DEMO_AS_OF_DATE=

# Name recorded as approver in audit logs (no auth in the demo).
DEMO_USER=demo.owner
