# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. Supabase: Connect -> "Session pooler" (port 5432), locally and on Vercel.
# Do NOT use the transaction pooler (port 6543): queries get stuck on it.
# The session pooler allows pool_size clients (15 on the free tier); on Vercel each instance keeps at most 2.
# Local Postgres also works, e.g.
# postgres://postgres:postgres@localhost:5432/pharmaos
DATABASE_URL=

# Gemini API key from Google AI Studio (aistudio.google.com/apikey). Server-side only.
# Leave empty to run with the deterministic fallback.
GEMINI_API_KEY=
# Model for the orchestrator. Pin a specific model name on demo day if needed.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: fix "today" for reproducible demos (YYYY-MM-DD). Empty = latest sale_date in the data.
DEMO_AS_OF_DATE=

# Name recorded as approver in audit logs (no auth in the demo).
DEMO_USER=demo.owner

# Owner email after an agent run orders stock (optional; skipped when either is empty). Resend: https://resend.com
# With the test sender below, Resend only delivers to the email address of your own Resend account.
RESEND_API_KEY=
OWNER_EMAIL=
# EMAIL_FROM="PharmaOS <onboarding@resend.dev>"
